# Runtime
# NODE_ENV controls framework/runtime behavior. Use "development" locally and "production" in deployed environments.
NODE_ENV=development

# HTTP port used by NestJS.
PORT=3000

# PostgreSQL connection used by DatabaseModule and TypeORM migrations.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orbis

# Enables TypeORM query logging. Use "false" in production unless debugging.
DB_LOGGING=true

# Auth
# JWT_SECRET must be a long random secret in every real environment.
JWT_SECRET=change-me

# Token lifetimes in seconds. Defaults: 3600 = 1 hour, 604800 = 7 days.
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=604800

# Password hashing cost. Higher is slower and stronger.
BCRYPT_SALT_ROUNDS=10

# Frontend origin allowed by backend integrations such as CORS, links, or redirects.
FRONTEND_URL=http://localhost:5173

# Initial owner user created by the database seed migration.
# Use a real email and a strong password in non-local environments.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-super-secret

# Enables write operations for roles/permissions when the project supports admin role editing.
ROLES_WRITE_ENABLED=false

# S3-compatible storage. Leave empty to disable or when storage is not configured.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# Presigned URL expiration in seconds.
S3_PRESIGNED_URL_TTL=600
